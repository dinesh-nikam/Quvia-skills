# Ultra Skills - NPM Ignore
# Prevents unwanted files from being published to npm

# Version control
.git/
.gitignore

# Dependencies
node_modules/
package-lock.json
yarn.lock
yarn-err.log*
bun.lock*

# Build artifacts
dist/
build/
out/
target/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS temp files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Testing
coverage/
.nyc_output/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.venv/
